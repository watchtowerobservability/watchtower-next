{
  "name": "@watchtowerobservability/next",
  "version": "0.1.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/watchtowerobservability/watchtower-next.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "description": "Watchtower for Next.js: edge-safe instrumentation register(), withWatchtower config, RUM component and tunnel",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "edge-light": "./dist/edge.js",
      "worker": "./dist/edge.js",
      "browser": "./dist/edge.js",
      "node": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./tunnel": {
      "types": "./dist/tunnel.d.ts",
      "default": "./dist/tunnel.js"
    },
    "./rum": {
      "types": "./dist/rum.d.ts",
      "default": "./dist/rum.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@watchtowerobservability/browser": ">=0.5.5",
    "@watchtowerobservability/node": ">=0.7.9",
    "next": ">=14",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@watchtowerobservability/browser": {
      "optional": true
    },
    "@watchtowerobservability/node": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsgo -p tsconfig.build.json",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "22.15.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "^18.3.1",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@watchtowerobservability/browser": "0.5.8",
    "@watchtowerobservability/node": "0.7.9",
    "happy-dom": "21.0.4",
    "next": "15.5.6",
    "react": "19.3.1",
    "react-dom": "18.3.1",
    "vitest": "5.0.5"
  }
}
